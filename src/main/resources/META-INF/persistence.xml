<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                https://jakarta.ee/xml/ns/persistence
                https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="ShoppingServiceMVCPU"
                      transaction-type="RESOURCE_LOCAL">

        <!-- Hibernate là JPA Provider -->
        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <!-- Entity được quản lý -->
        <class>vn.iotstar.entity.Category</class>
        <class>vn.iotstar.entity.Video</class>
        <class>vn.iotstar.entity.User</class>
        <properties>

            <!-- ====================== -->
            <!-- MySQL                   -->
            <!-- ====================== -->

            <property
                    name="jakarta.persistence.jdbc.driver"
                    value="com.mysql.cj.jdbc.Driver"/>

            <property
                    name="jakarta.persistence.jdbc.url"
                    value="jdbc:mysql://localhost:3306/ShoppingServiceMVC?useSSL=false&amp;serverTimezone=Asia/Ho_Chi_Minh&amp;characterEncoding=UTF-8"/>

            <property
                    name="jakarta.persistence.jdbc.user"
                    value="root"/>

            <property
                    name="jakarta.persistence.jdbc.password"
                    value="12345"/>


            <!-- ====================== -->
            <!-- Hibernate               -->
            <!-- ====================== -->

            <property
                    name="hibernate.dialect"
                    value="org.hibernate.dialect.MySQLDialect"/>

            <!--
                validate = chỉ kiểm tra mapping.
                Không tự tạo / sửa database.
            -->
            <property
                    name="hibernate.hbm2ddl.auto"
                    value="validate"/>

            <!-- Hiển thị SQL -->
            <property
                    name="hibernate.show_sql"
                    value="true"/>

            <!-- Format SQL -->
            <property
                    name="hibernate.format_sql"
                    value="true"/>

        </properties>

    </persistence-unit>

</persistence>