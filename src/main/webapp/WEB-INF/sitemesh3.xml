<?xml version="1.0" encoding="UTF-8"?>

<sitemesh>

    <!-- =========================================================
         USER DECORATOR
         ========================================================= -->
    <mapping
            path="/user/*"
            decorator="user.jsp"/>


    <!-- =========================================================
         ADMIN DECORATOR
         ========================================================= -->
    <mapping
            path="/admin/*"
            decorator="admin.jsp"/>


    <!-- =========================================================
         STATIC RESOURCES - KHÔNG DECORATE
         ========================================================= -->

    <mapping
            path="/css/*"
            exclude="true"/>

    <mapping
            path="/js/*"
            exclude="true"/>

    <mapping
            path="/image"
            exclude="true"/>

    <mapping
            path="/images/*"
            exclude="true"/>

    <mapping
            path="/favicon.ico"
            exclude="true"/>

</sitemesh>